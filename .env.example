# Cámara
# CAMERA_SOURCE tiene prioridad sobre CAMERA_INDEX. Acepta http(s)://, rtsp:// o rtmp://
# Ejemplo DroidCam por WiFi: http://192.168.10.130:4747/video
# Ejemplo cámara IP MJPEG:   http://192.168.10.249:8080/video
CAMERA_SOURCE=
# Índice USB (/dev/videoN), solo se usa si CAMERA_SOURCE está vacío.
CAMERA_INDEX=0
WIDTH=640
HEIGHT=480
FPS_TARGET=15

# Servidor
HOST=0.0.0.0
# V2 usa 8001 para no chocar con V1 (8000).
PORT=8001

# Modelo: auto | utkface_onnx | caffe
MODEL_BACKEND=auto

# Detector de rostros: auto | yunet | haar
# auto usa YuNet si el modelo existe; si no, cae a Haar.
DETECTOR_BACKEND=auto
YUNET_MODEL=models/face_detection_yunet_2023mar.onnx
YUNET_SCORE_THRESHOLD=0.6
YUNET_NMS_THRESHOLD=0.3
# Ancho al que se reduce el frame para detectar (más bajo = más rápido).
YUNET_INPUT_WIDTH=320

# Detección y clasificación separadas:
# detectar cada DETECT_EVERY_N frames; clasificar cada INFER_EVERY_N.
DETECT_EVERY_N=2
INFER_EVERY_N=5
# Seguimiento por IoU entre detecciones (0.3 = 30% de solapamiento).
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_MISSES=2

# Rutas modelo propio UTKFace (ONNX)
UTKFACE_ONNX_PATH=models/utkface_mobilenetv2.onnx

# Rutas modelo fallback Caffe
CAFFE_AGE_PROTO=models/fallback/deploy_age.prototxt
CAFFE_AGE_MODEL=models/fallback/age_net.caffemodel
CAFFE_GENDER_PROTO=models/fallback/deploy_gender.prototxt
CAFFE_GENDER_MODEL=models/fallback/gender_net.caffemodel

# Inferencia
CONF_THRESHOLD=0.6

# Haar cascade (vacío = usar el incluido en opencv-python)
HAAR_PATH=

# Snapshots (vacío = deshabilitado por privacidad).
# Debe ser una subcarpeta del proyecto; las rutas que escapen del árbol
# del proyecto (../, absolutas externas) se rechazan con HTTP 400.
SNAP_FOLDER=

# Intervalo mínimo entre snapshots en segundos (rate-limit -> HTTP 429)
SNAPSHOT_MIN_INTERVAL=2

# Buckets de edad (orden fijo del modelo propio)
AGE_BUCKETS=0-2,3-9,10-19,20-29,30-39,40-49,50-59,60+

# Calidad JPEG del stream (30-95, opcional)
JPEG_QUALITY=80

# Seguridad opcional: si defines API_TOKEN, los POST a /api/snapshot y
# /api/camera/start|stop exigen el header "X-Api-Token: <valor>".
# Vacío = sin autenticación (solo recomendable en red de confianza).
API_TOKEN=
